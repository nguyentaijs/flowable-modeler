<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:flowable="http://flowable.org/dmn" xmlns:design="http://flowable.org/design" id="definition_sampleTierAssignment" name="sampleTierAssignment" namespace="http://www.flowable.org/dmn">
  <decision id="sampleTierAssignment" name="Tier assignment">
    <decisionTable id="decisionTable_sampleTierAssignment" hitPolicy="FIRST">
      <input label="score">
        <inputExpression id="inputExpression_1" typeRef="number">
          <text>score</text>
        </inputExpression>
      </input>
      <input label="test">
        <inputExpression id="inputExpression_New_input" typeRef="collection">
          <text>test</text>
        </inputExpression>
      </input>
      <output id="outputExpression_1" label="tier" name="tier" typeRef="string"></output>
      <rule>
        <description>Score 700 and above</description>
        <inputEntry id="inputEntry_1_1">
          <text><![CDATA[>= 700]]></text>
        </inputEntry>
        <inputEntry id="inputEntry_New_input">
          <text><![CDATA[${test}]]></text>
        </inputEntry>
        <outputEntry id="outputEntry_1_1">
          <text><![CDATA["A"]]></text>
        </outputEntry>
      </rule>
      <rule>
        <description>Anything lower</description>
        <inputEntry id="inputEntry_1_2">
          <text><![CDATA[-]]></text>
        </inputEntry>
        <inputEntry id="inputEntry_New_input_1">
          <text><![CDATA[-]]></text>
        </inputEntry>
        <outputEntry id="outputEntry_1_2">
          <text><![CDATA["B"]]></text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI></dmndi:DMNDI>
</definitions>
