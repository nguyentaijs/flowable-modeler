  <process id="sampleMainProcess" name="sampleMainProcess" isExecutable="true" flowable:candidateStarterGroups="flowableUser">
    <extensionElements>
      <flowable:candidates-type><![CDATA[all]]></flowable:candidates-type>
      <design:stencilid><![CDATA[BPMNDiagram]]></design:stencilid>
      <design:creationdate><![CDATA[2026-10-06T03:03:51.449Z]]></design:creationdate>
      <design:modificationdate><![CDATA[2026-10-08T07:41:05.211Z]]></design:modificationdate>
    </extensionElements>
    <callActivity id="CallActivity_CallProcess" name="Call custom promotion" calledElement="${selectedProcessId}" flowable:fallbackToDefaultTenant="true">
      <extensionElements>
        <flowable:in source="requestData" target="requestData"></flowable:in>
        <flowable:in source="promotions" target="promotions"></flowable:in>
        <flowable:out source="decisionResult" target="promotionDecisionResult"></flowable:out>
        <flowable:static-process-key><![CDATA[${availablePromotion.processId}]]></flowable:static-process-key>
        <design:stencilid><![CDATA[CallActivity]]></design:stencilid>
      </extensionElements>
    </callActivity>
    <callActivity id="CallActivity_CallCoreProcess" name="Call Standard" calledElement="${selectedProcessId != null ? selectedProcessId : defaultProcessId}" flowable:fallbackToDefaultTenant="true">
      <extensionElements>
        <flowable:in source="requestData" target="requestData"></flowable:in>
        <flowable:in source="promotions" target="promotions"></flowable:in>
        <flowable:out source="decisionResult" target="standardDecisionResult"></flowable:out>
        <flowable:static-process-key><![CDATA[${availablePromotion != null && availablePromotion.coreProcessId != null ? availablePromotion.coreProcessId : defaultCoreProcessId}]]></flowable:static-process-key>
        <design:stencilid><![CDATA[CallActivity]]></design:stencilid>
      </extensionElements>
    </callActivity>
    <scriptTask id="ScriptTask_Log_variables" name="Log variables" scriptFormat="groovy" flowable:autoStoreVariables="false">
      <extensionElements>
        <design:stencilid>ScriptTask</design:stencilid>
        <design:stencilsuperid>Task</design:stencilsuperid>
      </extensionElements>
      <script><![CDATA[// Placeholder script for "Log variables": replace with real logic.
def processInstanceId = execution.getProcessInstanceId()
execution.setVariable('logVariablesDone', true)
]]></script>
    </scriptTask>
    <scriptTask id="ScriptTask_32" name="Prepare promotions" scriptFormat="groovy" flowable:autoStoreVariables="false">
      <extensionElements>
        <design:stencilid><![CDATA[ScriptTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
      <script><![CDATA[// Placeholder script for "Prepare promotions": replace with real logic.
def processInstanceId = execution.getProcessInstanceId()
execution.setVariable('preparePromotionsDone', true)
]]></script>
    </scriptTask>
    <scriptTask id="ScriptTask_52" name="Merge result" scriptFormat="groovy" flowable:autoStoreVariables="false">
      <extensionElements>
        <design:stencilid><![CDATA[ScriptTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
      <script><![CDATA[// Placeholder script for "Merge result": replace with real logic.
def processInstanceId = execution.getProcessInstanceId()
execution.setVariable('mergeResultDone', true)
]]></script>
    </scriptTask>
