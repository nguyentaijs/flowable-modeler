<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:flowable="http://flowable.org/dmn" xmlns:design="http://flowable.org/design" id="definition_sampleOfferConfigurations" name="sampleOfferConfigurations" namespace="http://www.flowable.org/dmn">
  <decision id="sampleOfferConfigurations" name="Offer configurations">
    <decisionTable id="decisionTable_sampleOfferConfigurations" hitPolicy="COLLECT" aggregation="SUM">
      <input label="segment">
        <inputExpression id="inputExpression_1" typeRef="string">
          <text>segment</text>
        </inputExpression>
      </input>
      <input label="orderCount">
        <inputExpression id="inputExpression_2" typeRef="number">
          <text>orderCount</text>
        </inputExpression>
      </input>
      <output id="outputExpression_1" label="bonusPoints" name="bonusPoints" typeRef="number"></output>
      <rule>
        <description>Premium bonus</description>
        <inputEntry id="inputEntry_1_1"><text><![CDATA[== "premium"]]></text></inputEntry>
        <inputEntry id="inputEntry_2_1"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="outputEntry_1_1"><text><![CDATA[100]]></text></outputEntry>
      </rule>
      <rule>
        <description>Loyalty bonus</description>
        <inputEntry id="inputEntry_1_2"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="inputEntry_2_2"><text><![CDATA[>= 10]]></text></inputEntry>
        <outputEntry id="outputEntry_1_2"><text><![CDATA[50]]></text></outputEntry>
      </rule>
      <rule>
        <description>Welcome bonus</description>
        <inputEntry id="inputEntry_1_3"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="inputEntry_2_3"><text><![CDATA[< 2]]></text></inputEntry>
        <outputEntry id="outputEntry_1_3"><text><![CDATA[20]]></text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI></dmndi:DMNDI>
</definitions>
