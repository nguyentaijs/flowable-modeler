# Dependencies
node_modules/

# Build output (generated by scripts/build.mjs)
dist/

# VS Code extension packages
*.vsix

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Environment / secrets
.env
.env.*

# Test / coverage output
coverage/
.nyc_output/

# Caches
.cache/
.eslintcache
*.tsbuildinfo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files (keep shared launch/tasks configs)
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp

# Reference material (not part of the extension)
references/

# Settings VS Code writes when samples/ is opened as a workspace (machine-specific paths)
samples/.vscode/

# Distributable packages are tracked
!distribute/*.vsix
